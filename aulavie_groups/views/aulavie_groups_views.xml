<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Lista -->
    <record id="view_aulavie_groups_tree" model="ir.ui.view">
        <field name="name">aulavie.groups.tree</field>
        <field name="model">aulavie.groups</field>
        <field name="arch" type="xml">
            <list string="Grupos">
                <field name="name"/>
                <field name="fecha_inicio"/>
                <field name="dias_ids" widget="many2many_tags"/>
                <field name="hora_inicio" widget="float_time"/>
                <field name="hora_fin" widget="float_time"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="view_aulavie_groups_form" model="ir.ui.view">
        <field name="name">aulavie.groups.form</field>
        <field name="model">aulavie.groups</field>
        <field name="arch" type="xml">
            <form string="Grupo">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="fecha_inicio"/>
                        <field name="dias_ids" widget="many2many_tags"/>
                        <field name="hora_inicio" widget="float_time"/>
                        <field name="hora_fin" widget="float_time"/>
                    </group>
                    <notebook>
                        <page string="Contactos">
                            <field name="contactos_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sesiones">
                            <field name="sesion_ids">
                                <list>
                                    <field name="nombre"/>
                                    <field name="fecha_hora_inicio"/>
                                    <field name="fecha_hora_fin"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Calendario de Sesiones -->
    <record id="view_aulavie_sesiones_calendar" model="ir.ui.view">
        <field name="name">aulavie.sesiones.calendar</field>
        <field name="model">aulavie.sesiones</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de Sesiones"
                      date_start="fecha_hora_inicio"
                      date_stop="fecha_hora_fin"
                      color="grupo_id"
                      mode="week">
                <field name="nombre"/>
                <field name="grupo_id"/>
            </calendar>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_aulavie_groups" model="ir.actions.act_window">
        <field name="name">Grupos</field>
        <field name="res_model">aulavie.groups</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
