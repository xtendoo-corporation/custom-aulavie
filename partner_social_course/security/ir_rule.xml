<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Alumno: solo puede ver/editar su propio contacto -->
     <record id="rule_partner_alumno_self" model="ir.rule">
        <field name="name">Alumno: ver solo su contacto</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('partner_social_course.group_aulavie_alumno'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Profesor: puede ver su propio contacto y el de sus alumnos -->
    <record id="rule_partner_profesor_own_and_students" model="ir.rule">
        <field name="name">Profesor: ver su contacto y sus alumnos</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|', ('id', '=', user.partner_id.id), ('profesor_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('partner_social_course.group_aulavie_profesor'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

</odoo>

