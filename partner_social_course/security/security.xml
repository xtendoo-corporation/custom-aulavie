<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Grupo Alumno Aulavie -->
    <record id="group_aulavie_alumno" model="res.groups">
        <field name="name">Aulavie / Alumno</field>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user'))
        ]"/>
    </record>

    <record id="group_aulavie_profesor" model="res.groups">
        <field name="name">Aulavie / Profesor</field>
        <field name="implied_ids" eval="[
            (4, ref('partner_social_course.group_aulavie_alumno')),
            (4, ref('hr_attendance.group_hr_attendance_user'))
        ]"/>
    </record>


</odoo>

