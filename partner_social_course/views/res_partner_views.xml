<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_inherit_social_course" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.social.course</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Redes y Cursos">
                    <group string="Configuración">
                        <field name="permitir_salir_redes_sociales"/>
                    </group>
                    <group string="Cursos y Grupos">
                        <field name="aulavie_group_ids" widget="many2many_tags" readonly="1"/>
                    </group>

                    <group string="Alumnos asociados" invisible="rol_contacto != 'profesor'">
                        <field name="alumno_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="rol_contacto"/>
                            </list>
                        </field>
                    </group>
                </page>

                <page string="Datos alumno">
                    <group>
                        <field name="fecha_nacimiento"/>
                        <field name="colegio_actual"/>
                        <field name="nivel_escolar_id"/>
                        <field name="alergias_intolerancias"/>
                        <field name="permitir_volver_solo_casa"/>
                    </group>
                    <group>
                        <field name="tiene_necesidades_especiales"/>
                        <field name="necesidades_especiales_detalle"
                               invisible="not tiene_necesidades_especiales"
                               required="tiene_necesidades_especiales"/>
                    </group>
                </page>

            </xpath>

            <!-- Mostrar el tipo (Padre/Madre/Tutor) en las tarjetas de contactos hijos -->
            <xpath expr="//field[@name='child_ids']/kanban//templates//main/field[@name='name']" position="before">
                <div invisible="type not in ('padre', 'madre', 'tutor legal')" class="fw-bold text-uppercase mb-1" style="color: #017e84; font-size: 0.9em;">
                    <field name="type"/>
                </div>
            </xpath>

        </field>
    </record>

    <!-- Mantengo tus vistas de cursos -->
    <record id="view_partner_course_list" model="ir.ui.view">
        <field name="name">partner.course.list</field>
        <field name="model">partner.course</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_partner_course_form" model="ir.ui.view">
        <field name="name">partner.course.form</field>
        <field name="model">partner.course</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_partner_course" model="ir.actions.act_window">
        <field name="name">Cursos</field>
        <field name="res_model">partner.course</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_partner_course_root"
        name="Cursos"
        parent="contacts.res_partner_menu_config"
        action="action_partner_course"
        sequence="90"
    />

</odoo>
