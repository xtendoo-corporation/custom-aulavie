<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View for the wizard -->
    <record id="view_import_alumnos_wizard_form" model="ir.ui.view">
        <field name="name">import.alumnos.wizard.form</field>
        <field name="model">import.alumnos.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Alumnos desde Excel">
                <group>
                    <field name="file" filename="filename" widget="binary"/>
                    <field name="filename" invisible="1"/>
                </group>
                <div class="text-muted mt16 font-italic">
                    Sube un archivo Excel (.xlsx) que contenga la información de los alumnos. El sistema
                    buscará en la fila 1 (cabeceras) aquellas celdas que incluyan palabras como "Nombre y apellidos del alumno",
                    "Dirección del alumno", "Colegio actual", "Alergias o intolerancias",
                    "Nombre y apellido del tutor/a legal 1", etc.<br/>
                    Todos los alumnos insertados se crearán automáticamente con el rol "Alumno".
                </div>
                <footer>
                    <button name="process_import" type="object" string="Importar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for the wizard -->
    <record id="action_import_alumnos_wizard" model="ir.actions.act_window">
        <field name="name">Importar Alumnos</field>
        <field name="res_model">import.alumnos.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item (under Contacts -> Configuration) -->
    <menuitem id="menu_import_alumnos"
              name="Importar Alumnos"
              parent="contacts.res_partner_menu_config"
              action="action_import_alumnos_wizard"
              sequence="100"/>
</odoo>
